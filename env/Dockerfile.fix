# Thin fix layer on top of the last full gdpval-video build.
# Prefer rebuilding via env/Dockerfile for from-scratch; this avoids a 15min pip reinstall
# when only the numpy pin changed.
ARG BASE_IMAGE=gdpval-video:local
FROM --platform=linux/amd64 ${BASE_IMAGE}
USER root
RUN python -m pip uninstall -y coverage pytest-cov \
    && python -m pip install --no-cache-dir --force-reinstall \
         'librosa==0.10.2' 'numpy==1.24.0'
USER appuser
