SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Optional override for first-run admin email (default admin@gdpval.local)
# BOOTSTRAP_ADMIN_EMAIL=you@company.com

# Persistent data (SQLite + local media). On Render, set to the disk mount, e.g. /var/data
# DATA_DIR=/var/data

# Optional: store/serve videos via S3-compatible storage (Cloudflare R2 recommended)
# MEDIA_BACKEND=s3
# S3_BUCKET=gdpval-videos
# S3_REGION=auto
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PREFIX=media
