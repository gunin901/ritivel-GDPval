SESSION_SECRET=replace-with-a-long-random-string-at-least-32-chars
# Optional override for first-run admin email (default admin@gdpval.local)
# BOOTSTRAP_ADMIN_EMAIL=you@company.com

# Persistent SQLite (Render disk). Videos should live on S3 when MEDIA_BACKEND=s3.
# DATA_DIR=/var/data

# --- Amazon S3 video storage (recommended for production) ---
MEDIA_BACKEND=s3
S3_BUCKET=gdpval-eval-videos
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=media
S3_SIGNED_URL_TTL=7200
# S3_USE_ACCELERATE=true

# R2 only (leave unset for AWS S3):
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
